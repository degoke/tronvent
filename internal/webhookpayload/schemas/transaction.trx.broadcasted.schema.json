{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tronvent.dev/schemas/transaction.trx.broadcasted",
  "title": "transaction.trx.broadcasted",
  "description": "TRX transfer where a watched address is the sender.",
  "type": "object",
  "required": ["type", "timestamp", "data"],
  "properties": {
    "type": { "const": "transaction.trx.broadcasted" },
    "timestamp": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["id", "txHash", "fromAddress", "toAddress", "amount", "blockNumber", "blockTimestamp", "confirmations"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "txHash": { "type": "string" },
        "fromAddress": { "type": "string" },
        "toAddress": { "type": "string" },
        "amount": { "type": "string", "description": "TRX amount as a decimal string" },
        "tokenContractAddress": { "type": "string" },
        "blockNumber": { "type": "integer" },
        "blockTimestamp": { "type": "integer", "description": "Block time in milliseconds since epoch" },
        "confirmations": { "type": "integer", "minimum": 0, "description": "Blocks the chain tip was ahead of blockNumber when Tronvent matched the transfer. Frozen at that moment and not refreshed on retries, so do not use it as a finality check" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
