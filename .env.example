# Required
DATABASE_URL=postgres://user:pass@localhost:5432/tronvent
TRONGRID_API_KEY_SCANNER=

# TronGrid & polling
TRONGRID_BASE_URL=https://api.trongrid.io
# TRONGRID_BASE_URL=https://api.shasta.trongrid.io
# TRONGRID_BASE_URL=https://nile.trongrid.io
TRON_POLL_INTERVAL_MS=3000
TRON_START_BLOCK=0
TRON_REQUIRED_CONFIRMATIONS=20
TRON_TRC20_EVENT_CONFS=10
TRON_TRC20_CURSOR_RETAIN=50
TRON_TRC20_EVENT_RETRIES=3
TRON_TRC20_EVENT_RETRY_DELAY_MS=2000
TRON_FETCH_CONCURRENCY=5
TRON_HTTP_TIMEOUT_SECONDS=60
TRON_RECONCILE_BATCH_SIZE=1000
# Comma-separated; seeds scanner_watched_contracts when empty (default: USDT mainnet)
# TRON_TRC20_CONTRACTS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Webhook delivery (bootstrap when no DB row exists)
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_HTTP_TIMEOUT_SECONDS=30

# Server (health, metrics, admin API, dashboard)
HEALTH_PORT=8080
# Required for /api/v1/* and /dashboard login
ADMIN_API_TOKEN=
STATE_RESYNC_INTERVAL_SECONDS=60

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FORMAT=text
